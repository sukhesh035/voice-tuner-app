{
  "name": "admin-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin-api/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/admin-api"],
      "options": {
        "command": "node_modules/.bin/esbuild apps/admin-api/src/handler.ts --bundle --minify --platform=node --target=node22 --format=cjs --external:@aws-sdk/client-dynamodb --external:@aws-sdk/lib-dynamodb --outfile=dist/apps/admin-api/handler.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": { "lintFilePatterns": ["apps/admin-api/**/*.ts"] }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "apps/admin-api/jest.config.ts" }
    }
  }
}
